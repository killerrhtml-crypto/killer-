<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchBotEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bot_enabled_label"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/min_price_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMinPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvZonesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zones_label"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/spinnerZones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvSubscriptionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subscription_unknown"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnTestOffer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/test_offer_button"
        android:layout_marginTop="24dp" />

</LinearLayout>
